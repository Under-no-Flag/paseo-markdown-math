{
  "name": "paseo-markdown-math",
  "version": "0.2.1",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "scripts/prepare-install.mjs",
    "examples/",
    "docs/",
    "OVERVIEW.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json && tsc -p tsconfig.frame.json",
    "build": "npm run assets && node scripts/build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm run typecheck && npm test",
    "dev": "npm run build && vite --host 127.0.0.1",
    "verify:host": "node scripts/verify-host.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test:package": "node scripts/package-test.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.13.0",
    "@playwright/test": "1.64.1",
    "@tanstack/react-query": "5.104.5",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.28.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "0.21.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "zod": "4.6.7",
    "mermaid": "12.2.0"
  },
  "type": "module",
  "description": "Paseo Markdown preview with KaTeX, Mermaid, workspace images and document links",
  "dependencies": {
    "@mdit/plugin-katex": "1.1.4",
    "katex": "0.19.1",
    "markdown-it": "15.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Under-no-Flag/paseo-markdown-math.git"
  },
  "homepage": "https://github.com/Under-no-Flag/paseo-markdown-math#readme",
  "bugs": {
    "url": "https://github.com/Under-no-Flag/paseo-markdown-math/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "markdown",
    "katex",
    "latex",
    "mermaid"
  ],
  "bundleDependencies": [
    "@mdit/plugin-katex",
    "katex",
    "markdown-it"
  ]
}
